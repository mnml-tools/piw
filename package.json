{
  "name": "piw",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal, local-first notes and tasks for the desktop.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "packageManager": "pnpm@11.26.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "rust:lint": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --locked -- -D warnings",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "rust:check": "pnpm rust:fmt && pnpm rust:lint && pnpm rust:test",
    "bindings": "cargo test --manifest-path src-tauri/Cargo.toml --locked export_bindings",
    "verify": "pnpm check && pnpm rust:check && pnpm build",
    "test:editor-perf": "EDITOR_PERF=1 vitest run src/lib/editor/__tests__/performance.test.ts --testTimeout=60000"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@tanstack/react-query": "5.106.1",
    "@tauri-apps/api": "2.12.4",
    "@tiptap/core": "3.33.0",
    "@tiptap/extension-code-block-lowlight": "3.33.0",
    "@tiptap/extension-link": "3.33.0",
    "@tiptap/extension-list": "3.33.0",
    "@tiptap/extensions": "3.33.0",
    "@tiptap/markdown": "3.33.0",
    "@tiptap/pm": "3.33.0",
    "@tiptap/react": "3.33.0",
    "@tiptap/starter-kit": "3.33.0",
    "lowlight": "3.3.0",
    "lucide-react": "1.70.0",
    "marked": "17.0.6",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
