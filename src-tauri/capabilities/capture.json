{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "capture",
  "description": "Quick Capture popup: create notes/tasks, keep a draft, pin after saving, or append to a vault Inbox. Nothing else.",
  "windows": ["capture"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "allow-get-settings",
    "allow-get-capture-draft",
    "allow-save-capture-draft",
    "allow-clear-capture-draft",
    "allow-open-sticky",
    "allow-hide-capture",
    "allow-vault-status",
    "allow-vault-tree",
    "allow-vault-capture",
    "allow-vault-pin-note",
    "allow-spike-ack"
  ]
}
