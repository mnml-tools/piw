{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "sticky",
  "description": "Sticky windows: show and edit their one item, manage their own window. Nothing else.",
  "windows": ["sticky:*"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "allow-get-settings",
    "allow-get-sticky",
    "allow-close-sticky",
    "allow-unpin-sticky",
    "allow-set-sticky-always-on-top",
    "allow-set-sticky-color",
    "allow-open-in-workspace",
    "allow-get-note",
    "allow-update-note-text",
    "allow-get-task",
    "allow-update-task-text",
    "allow-set-task-completed",
    "allow-create-task",
    "allow-list-document-tasks",
    "allow-get-tab",
    "allow-get-document",
    "allow-spike-ack"
  ]
}
