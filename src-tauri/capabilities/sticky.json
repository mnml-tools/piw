{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "sticky",
  "description": "Sticky windows: show and edit their one item, manage their own window. Vault stickies reach only their own note or task view (commands/vault.rs). Nothing else.",
  "windows": ["sticky:*"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "allow-get-settings",
    "allow-get-sticky",
    "allow-close-sticky",
    "allow-unpin-sticky",
    "allow-set-sticky-always-on-top",
    "allow-set-sticky-color",
    "allow-open-in-workspace",
    "allow-vault-read-note",
    "allow-vault-write-note",
    "allow-vault-tasks",
    "allow-vault-edit-task",
    "allow-vault-sticky-view",
    "allow-vault-capture",
    "allow-spike-ack"
  ]
}
