{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Workspace window: every app command (it is the full UI), event listening and the window controls of its own title bar (drag, resize, minimize, maximize, close). No other core APIs.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "allow-platform-info",
    "allow-show-capture",
    "allow-hide-capture",
    "allow-open-in-workspace",
    "allow-retry-shortcut",
    "allow-open-sticky",
    "allow-close-sticky",
    "allow-unpin-sticky",
    "allow-set-sticky-always-on-top",
    "allow-set-sticky-color",
    "allow-get-sticky",
    "allow-list-pinned",
    "allow-reset-sticky-positions",
    "allow-quit-app",
    "allow-app-status",
    "allow-list-spaces",
    "allow-create-space",
    "allow-rename-space",
    "allow-set-space-color",
    "allow-set-default-space",
    "allow-space-item-count",
    "allow-delete-space",
    "allow-list-inbox",
    "allow-inbox-count",
    "allow-mark-inbox-triaged",
    "allow-list-trash",
    "allow-empty-trash",
    "allow-list-tags",
    "allow-search",
    "allow-get-settings",
    "allow-update-settings",
    "allow-remember-capture-space",
    "allow-get-capture-draft",
    "allow-save-capture-draft",
    "allow-clear-capture-draft",
    "allow-export-data",
    "allow-choose-export-folder",
    "allow-write-export",
    "allow-backup-database",
    "allow-list-notes",
    "allow-get-note",
    "allow-create-note",
    "allow-update-note-text",
    "allow-discard-note-if-empty",
    "allow-set-note-archived",
    "allow-move-note",
    "allow-trash-note",
    "allow-restore-note",
    "allow-purge-note",
    "allow-set-note-triaged",
    "allow-set-note-tags",
    "allow-get-document",
    "allow-get-tab",
    "allow-create-document",
    "allow-convert-note-to-document",
    "allow-revert-document-conversion",
    "allow-create-tab",
    "allow-rename-tab",
    "allow-reorder-tabs",
    "allow-update-tab-content",
    "allow-update-tab-settings",
    "allow-duplicate-tab",
    "allow-delete-tab",
    "allow-restore-tab",
    "allow-trash-document",
    "allow-document-move-preview",
    "allow-set-document-in-sidebar",
    "allow-list-tasks",
    "allow-list-document-tasks",
    "allow-count-completed-tasks",
    "allow-get-task",
    "allow-create-task",
    "allow-update-task-text",
    "allow-set-task-completed",
    "allow-set-task-due-date",
    "allow-move-task",
    "allow-set-task-document",
    "allow-reorder-tasks",
    "allow-trash-task",
    "allow-restore-task",
    "allow-purge-task",
    "allow-set-task-triaged",
    "allow-set-task-tags",
    "allow-spike-broadcast",
    "allow-spike-ack",
    "allow-open-link"
  ]
}
