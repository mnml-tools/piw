{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Workspace window: every app command (it is the full UI), event listening and the window controls of its own title bar (drag, resize, minimize, maximize, close). No other core APIs.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "allow-platform-info",
    "allow-show-capture",
    "allow-hide-capture",
    "allow-open-in-workspace",
    "allow-retry-shortcut",
    "allow-open-sticky",
    "allow-close-sticky",
    "allow-unpin-sticky",
    "allow-set-sticky-always-on-top",
    "allow-set-sticky-color",
    "allow-get-sticky",
    "allow-reset-sticky-positions",
    "allow-quit-app",
    "allow-app-status",
    "allow-get-settings",
    "allow-update-settings",
    "allow-get-capture-draft",
    "allow-save-capture-draft",
    "allow-clear-capture-draft",
    "allow-vault-status",
    "allow-vault-tree",
    "allow-vault-read-note",
    "allow-vault-write-note",
    "allow-vault-create-note",
    "allow-vault-create-folder",
    "allow-vault-rename",
    "allow-vault-trash",
    "allow-vault-list-trash",
    "allow-vault-restore",
    "allow-vault-purge",
    "allow-vault-search",
    "allow-vault-resolve-link",
    "allow-vault-tasks",
    "allow-vault-edit-task",
    "allow-vault-pin-note",
    "allow-vault-pin-tasks",
    "allow-vault-sticky-view",
    "allow-vault-pinned",
    "allow-vault-capture",
    "allow-vault-sticky-note",
    "allow-vault-import-status",
    "allow-vault-import",
    "allow-choose-vault-folder",
    "allow-spike-broadcast",
    "allow-spike-ack",
    "allow-open-link"
  ]
}
